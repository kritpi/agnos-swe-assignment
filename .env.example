# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080

# ─── Nginx ────────────────────────────────────────────────────────────────────
# Host port nginx publishes; the API itself is only reachable through nginx.
NGINX_PORT=80

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# DB_HOST is overridden to "postgres" inside docker-compose.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=agnos
DB_SSLMODE=disable

# ─── Hospital Information Systems (HIS) ───────────────────────────────────────
# Full endpoint URL; the adapter appends the national ID or passport ID.
HIS_HOSPITAL_A_SEARCH_PATIENT_URL=https://hospital-a.api.co.th/patient/search
HIS_HOSPITAL_A_TIMEOUT=10s
