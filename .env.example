# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# DB_HOST is overridden to "postgres" inside docker-compose.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=agnos
DB_SSLMODE=disable
